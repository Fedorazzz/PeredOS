// ПередОС — настройки APT

// Повторять неудачные загрузки
Acquire::Retries "3";

// Не тянуть рекомендуемые и предлагаемые пакеты автоматически
APT::Install-Recommends "false";
APT::Install-Suggests "false";

// Периодическое обновление списков и очистка кэша
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::AutocleanInterval "7";

Dpkg::Progress-Fancy "1";
APT::Color "true";
