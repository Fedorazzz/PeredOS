# ПередОС — шаблон fstab для установщика
# Не копируется в live-систему: UUID-плейсхолдеры (ROOT_UUID, HOME_UUID, BOOT_UUID)
# нужно заменить на реальные значения из blkid. Для Btrfs fsck-проход = 0.
# <file system>                           <mount point>   <type>  <options>                        <dump>  <pass>

# Корневая файловая система (Btrfs)
UUID=ROOT_UUID    /           btrfs   defaults,noatime,compress=zstd:3,subvol=@           0       0

# Домашний раздел (Btrfs)
UUID=HOME_UUID    /home       btrfs   defaults,noatime,compress=zstd:3,subvol=@home       0       0

# Загрузочный раздел (EFI)
UUID=BOOT_UUID    /boot/efi   vfat    defaults,noatime,umask=0077                         0       2

# Временные файлы в RAM
tmpfs             /tmp        tmpfs   defaults,noatime,nosuid,nodev,size=2G               0       0

# /var/log остаётся на диске: журнал systemd и аудит должны переживать перезагрузку
